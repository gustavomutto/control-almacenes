<%- include('../partials/head', { titulo: 'Reporte mensual — ' + almacen.nombre }) %>
<%- include('../partials/barra', { usuario, activo: 'reporte' }) %>
<main>
  <div class="panel">
    <div class="fila-filtro">
      <div>
        <h2 style="margin-bottom:2px"><%= almacen.nombre %></h2>
        <p class="ayuda" style="margin:0">Reporte mensual</p>
      </div>
      <form method="get" action="/almacen/reporte" style="margin-left:auto">
        <label class="campo">Mes <input type="month" name="mes" value="<%= mes %>" onchange="this.form.submit()"></label>
      </form>
    </div>

    <div class="tarjetas">
      <div class="tarjeta venta"><span>Vendido en el mes</span><strong><%= fmt(totalMes.venta) %></strong></div>
      <div class="tarjeta"><span>Costo del material</span><strong><%= fmt(totalMes.costo) %></strong></div>
      <div class="tarjeta margen"><span>Ganancia real del mes (sin descontar gastos)</span><strong><%= fmt(totalMes.margen) %></strong></div>
      <div class="tarjeta gastos"><span>Gastos del mes</span><strong><%= fmt(totalGastosMes) %></strong></div>
    </div>
    <p class="ayuda">La ganancia real es lo que queda de vender por encima del costo del material (margen). Los gastos del mes se muestran aparte, sin restarse de esa ganancia.</p>

    <table class="tabla">
      <thead><tr><th>Día</th><th class="n">Vendido</th><th class="n">Costo</th><th class="n">Margen</th></tr></thead>
      <tbody>
        <% porDia.forEach(d => { %>
          <tr>
            <td><%= d.fecha.toISOString().slice(0,10) %></td>
            <td class="n"><%= fmt(d.venta) %></td>
            <td class="n"><%= fmt(d.costo) %></td>
            <td class="n"><%= fmt(d.margen) %></td>
          </tr>
        <% }) %>
        <% if (porDia.length === 0) { %><tr><td colspan="4" class="vacio">Sin ventas registradas este mes.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</main>
</body>
</html>
