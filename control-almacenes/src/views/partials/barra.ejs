<header class="barra">
  <div class="marca">
    <strong>Control de almacenes</strong>
    <small><%= usuario.rol === 'almacen' ? usuario.almacenNombre : (usuario.rol === 'admin' ? 'Administrador' : 'Vista general') %></small>
  </div>
  <nav>
    <% if (usuario.rol === 'almacen') { %>
      <a href="/almacen" class="<%= activo === 'panel' ? 'activo' : '' %>">Hoy</a>
      <a href="/almacen/reporte" class="<%= activo === 'reporte' ? 'activo' : '' %>">Reporte mensual</a>
    <% } else { %>
      <a href="/jefa" class="<%= activo === 'panel' ? 'activo' : '' %>">Hoy</a>
      <a href="/jefa/reporte" class="<%= activo === 'reporte' ? 'activo' : '' %>">Reporte mensual</a>
      <% if (usuario.rol === 'admin') { %>
        <a href="/jefa/admin" class="<%= activo === 'admin' ? 'activo' : '' %>">Almacenes y usuarios</a>
      <% } %>
    <% } %>
  </nav>
  <form method="post" action="/logout"><button class="btn-salir" type="submit">Salir (<%= usuario.nombre %>)</button></form>
</header>
