<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= doc.tipo === 'factura' ? 'Factura' : 'Cotización' %> N° <%= doc.numero %></title>
<link rel="stylesheet" href="/css/estilo.css?v=<%= v %>">
<link rel="stylesheet" href="/css/ticket.css?v=<%= v %>">
<link rel="icon" href="data:,">
<style>
<%- papelCss %>
</style>
</head>
<body class="modo-impresion">
  <div class="barra-imprimir no-print">
    <a class="btn linea" href="<%= volver %>">← Volver</a>
    <span>
      <%= doc.tipo === 'factura' ? 'Factura' : 'Cotización' %> N° <%= doc.numero %> ·
      <%= papelNombre %>
    </span>
    <button class="btn prim" onclick="window.print()">Imprimir</button>
  </div>

  <div id="print-area">
    <% if (papel === 'carta' || papel === 'media') { %>
      <%- include('partials/factura', { almacen, doc, items, pagos, hora, fechaTexto, fmt, fmtCant, densidad }) %>
    <% } else { %>
      <%- include('partials/ticket', { almacen, doc, items, pagos, hora, fechaTexto, fmt, fmtCant }) %>
    <% } %>
  </div>

<script>
// Red de seguridad: la factura no puede pasar del alto que de verdad imprime la máquina.
// Si se pasa, se encoge la letra hasta que quepa. Sin esto, el sobrante se iba a una
// segunda hoja —productos en una y firma en otra— y la impresora la reportaba como atasco.
(function ajustarAlaHoja() {
  var fx = document.querySelector('#print-area .fx');
  if (!fx) return;
  var tope = <%= altoMaximo %> * 96 / 25.4; // milímetros a pixeles
  var tam = parseFloat(getComputedStyle(fx).fontSize);
  for (var i = 0; i < 60 && fx.getBoundingClientRect().height > tope + 1 && tam > 5; i++) {
    tam -= 0.25;
    fx.style.fontSize = tam + 'px';
  }
})();
</script>
<% if (auto) { %>
<script>window.addEventListener('load', () => setTimeout(() => window.print(), 350));</script>
<% } %>
</body>
</html>
