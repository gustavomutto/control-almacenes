<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Cierre de caja — <%= fechaTexto %></title>
<link rel="stylesheet" href="/css/estilo.css?v=<%= v %>">
<link rel="stylesheet" href="/css/ticket.css?v=<%= v %>">
<link rel="icon" href="data:,">
<style><%- papelCss %></style>
</head>
<body class="modo-impresion">
  <div class="barra-imprimir no-print">
    <a class="btn linea" href="/almacen/caja?fecha=<%= fecha %>">← Volver</a>
    <span>Cierre de caja · <%= fechaTexto %></span>
    <button class="btn prim" onclick="window.print()">Imprimir</button>
  </div>

  <div id="print-area">
    <div class="tk">
      <div class="c"><%= almacen.encabezado || almacen.nombre %></div>
      <div class="c"><%= almacen.direccion %></div>
      <div class="c tk-tipo">CIERRE DE CAJA</div>
      <div class="c">NIT: <%= almacen.nit %></div>
      <div class="c">Tel: <%= almacen.telefono %></div>
      <div class="tk-f3"><span>Día:</span><span></span><span class="r"><%= fechaTexto %></span></div>
      <div class="tk-f3"><span>Impreso:</span><span></span><span class="r"><%= hora %></span></div>
      <div class="tk-cli">
        <span>FACTURAS: <%= resumen.cantidad %></span>
        <span class="r"><%= resumen.facturas.length ? resumen.facturas[0].numero + ' a ' + resumen.facturas[resumen.facturas.length-1].numero : '' %></span>
      </div>

      <div class="tk-cuadre">
        <span class="tk-grande">VENTA TOTAL</span><span class="r tk-grande"><%= fmt(resumen.total) %></span>
        <% resumen.metodos.forEach(m => { %>
          <span class="ind"><%= m.metodo %></span><span class="r"><%= fmt(m.valor) %></span>
        <% }) %>
        <i class="tk-sep"></i>
        <span>GASTOS</span><span></span>
        <% if (resumen.gastos.length === 0) { %>
          <span class="ind suave">Sin gastos</span><span></span>
        <% } else { resumen.gastos.forEach(g => { %>
          <span class="ind suave"><%= g.concepto %></span><span class="r suave"><%= fmt(g.valor) %></span>
        <% }) } %>
        <span>TOTAL GASTOS</span><span class="r"><%= fmt(resumen.totalGastos) %></span>
        <i class="tk-sep"></i>
        <span class="ind suave">Efectivo</span><span class="r suave"><%= fmt(resumen.efectivo) %></span>
        <span class="ind suave">Menos gastos</span><span class="r suave"><%= resumen.totalGastos ? '- ' + fmt(resumen.totalGastos) : fmt(0) %></span>
        <span class="tk-grande">EFECTIVO A ENTREGAR</span><span class="r tk-grande"><%= fmt(resumen.entregar) %></span>
      </div>

      <% if (arqueo) { %>
        <div class="tk-cuadre tk-arqueo">
          <i class="tk-sep"></i>
          <span>CONTEO DEL CAJÓN</span><span></span>
          <% arqueo.lineas.forEach(l => { %>
            <span class="ind suave"><%= fmt(l.valor) %> × <%= l.cantidad %></span>
            <span class="r suave"><%= fmt(l.subtotal) %></span>
          <% }) %>
          <% if (arqueo.lineas.length === 0) { %>
            <span class="ind suave">Sin billetes ni monedas</span><span></span>
          <% } %>
          <% if (arqueo.base) { %>
            <span class="ind suave">Base del día</span><span class="r suave"><%= fmt(arqueo.base) %></span>
          <% } %>
          <span>CONTADO</span><span class="r"><%= fmt(arqueo.contado) %></span>
          <span class="ind suave">Debería haber</span><span class="r suave"><%= fmt(arqueo.esperado) %></span>
          <span class="tk-grande">
            <%= arqueo.diferencia === 0 ? 'CUADRA' : arqueo.diferencia < 0 ? 'FALTA' : 'SOBRA' %>
          </span>
          <span class="r tk-grande"><%= fmt(Math.abs(arqueo.diferencia)) %></span>
          <% if (arqueo.nota) { %><span class="ind suave"><%= arqueo.nota %></span><span></span><% } %>
        </div>
      <% } %>

      <div class="tk-firmas"><div>Entregado por</div><div>Recibido por</div></div>
    </div>
  </div>

<script>
// Misma red de seguridad que la factura: con el conteo del cajón el cierre se alarga, y
// un milímetro de más se iba a una segunda hoja que la impresora reporta como atasco.
// Si se pasa del alto que de verdad imprime la máquina, se encoge la letra.
(function ajustarAlaHoja() {
  var tope = <%= altoMaximo %>;
  var tk = document.querySelector('#print-area .tk');
  if (!tk || !tope) return;
  var limite = tope * 96 / 25.4; // milímetros a pixeles
  var tam = parseFloat(getComputedStyle(tk).fontSize);
  for (var i = 0; i < 60 && tk.getBoundingClientRect().height > limite + 1 && tam > 5; i++) {
    tam -= 0.25;
    tk.style.fontSize = tam + 'px';
  }
})();
</script>
<% if (auto) { %>
<script>window.addEventListener('load', () => setTimeout(() => window.print(), 350));</script>
<% } %>
</body>
</html>
