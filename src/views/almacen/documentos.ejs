<%- include('../partials/head', { titulo: 'Facturas — ' + almacen.nombre }) %>
<%- include('../partials/barra', { usuario, activo: 'documentos' }) %>
<main>
  <% if (mensaje) { %><div class="mensaje ok"><%= mensaje %></div><% } %>
  <% if (error) { %><div class="mensaje error"><%= error %></div><% } %>

  <div class="panel">
    <div class="fila-filtro">
      <div>
        <h2 style="margin-bottom:2px"><%= tipo === 'factura' ? 'Facturas' : 'Cotizaciones' %> del día</h2>
        <p class="ayuda" style="margin:0"><%= almacen.nombre %></p>
      </div>
      <form method="get" action="/almacen/documentos" style="margin-left:auto;display:flex;gap:10px;flex-wrap:wrap">
        <label class="campo">Tipo
          <select name="tipo" onchange="this.form.submit()">
            <option value="factura" <%= tipo === 'factura' ? 'selected' : '' %>>Facturas</option>
            <option value="cotizacion" <%= tipo === 'cotizacion' ? 'selected' : '' %>>Cotizaciones</option>
          </select>
        </label>
        <% if (tipo === 'factura') { %>
          <label class="campo">Forma de pago
            <select name="pago" onchange="this.form.submit()">
              <option value="todos" <%= pago === 'todos' ? 'selected' : '' %>>Todas</option>
              <option value="efectivo" <%= pago === 'efectivo' ? 'selected' : '' %>>Efectivo</option>
              <option value="transferencia" <%= pago === 'transferencia' ? 'selected' : '' %>>Transferencia</option>
              <option value="mixto" <%= pago === 'mixto' ? 'selected' : '' %>>Solo las mixtas</option>
              <option value="sin" <%= pago === 'sin' ? 'selected' : '' %>>Sin forma de pago</option>
            </select>
          </label>
        <% } %>
        <label class="campo">Fecha <input type="date" name="fecha" value="<%= fecha %>" max="<%= hoy %>" onchange="this.form.submit()"></label>
      </form>
    </div>

    <div class="tarjetas">
      <div class="tarjeta venta">
        <span><%= pago === 'todos' ? 'Total del día' : 'Total de estas facturas' %></span>
        <strong><%= fmt(total) %></strong>
      </div>
      <div class="tarjeta">
        <span><%= pago === 'todos' ? 'Documentos' : 'Facturas que coinciden' %></span>
        <strong><%= documentos.filter(d => !d.anulada).length %></strong>
      </div>
      <% if (enEsteMetodo !== null) { %>
        <div class="tarjeta margen">
          <span>Entró en <%= filtroNombre.toLowerCase() %> ese día</span>
          <strong><%= fmt(enEsteMetodo) %></strong>
        </div>
      <% } %>
    </div>

    <% if (pago !== 'todos') { %>
      <p class="ayuda" style="margin:0 0 14px">
        <% if (pago === 'efectivo' || pago === 'transferencia') { %>
          Estás viendo las facturas que tienen algo pagado en <b><%= filtroNombre.toLowerCase() %></b>.
          Las mixtas aparecen aquí y también en el otro filtro, con su total completo; la tarjeta
          verde sí separa solo la parte que entró en <%= filtroNombre.toLowerCase() %>.
        <% } else if (pago === 'mixto') { %>
          Solo las facturas que se pagaron con <b>más de una forma de pago</b>.
        <% } else { %>
          Facturas a las que todavía <b>no se les anotó</b> cómo se pagaron.
        <% } %>
        <a href="/almacen/documentos?fecha=<%= fecha %>">Ver todas</a>
      </p>
    <% } %>

    <table class="tabla">
      <thead>
        <tr><th>N°</th><th>Cliente</th><th>Vendedor</th><th>Forma de pago</th><th class="n">Total</th><th></th></tr>
      </thead>
      <tbody>
        <% documentos.forEach(d => { %>
          <tr<%= d.anulada ? ' class="anulada"' : '' %>>
            <td>
              <%= d.numero %><%= d.anulada ? ' (anulada)' : '' %>
              <% if (tipo === 'factura' && Number(d.formas) > 1) { %><small class="etiqueta">mixta</small><% } %>
            </td>
            <td><%= d.cliente || 'Consumidor final' %></td>
            <td><%= d.vendedor || '—' %></td>
            <td>
              <% if (tipo === 'factura' && d.editable) { %>
                <form method="post" action="/almacen/documentos/<%= d.id %>/pagos" class="pago-rapido">
                  <input type="hidden" name="fecha" value="<%= fecha %>">
                  <input type="hidden" name="pago" value="<%= pago %>">
                  <select name="metodo_1">
                    <% metodos.forEach(m => { %><option <%= (d.pagos || '').startsWith(m) ? 'selected' : '' %>><%= m %></option><% }) %>
                  </select>
                  <input class="in n" type="number" name="valor_1" min="0" step="1" value="<%= Math.round(Number(d.total)) %>">
                  <select name="metodo_2">
                    <option value="">— y algo más…</option>
                    <% metodos.forEach(m => { %><option><%= m %></option><% }) %>
                  </select>
                  <input class="in n" type="number" name="valor_2" min="0" step="1" placeholder="0">
                  <button class="btn linea mini" type="submit">Guardar pago</button>
                </form>
                <small class="ayuda" style="margin:0"><%= d.pagos || 'sin registrar' %></small>
              <% } else { %>
                <%= d.pagos || '—' %>
              <% } %>
            </td>
            <td class="n"><%= fmt(d.total) %></td>
            <td class="n">
              <a class="btn linea mini" href="/almacen/imprimir/<%= d.id %>?auto=0">Ver / imprimir</a>
              <% if (d.editable) { %>
                <a class="btn linea mini" href="/almacen/documentos/<%= d.id %>/editar">Editar</a>
              <% } %>
              <% if (tipo === 'factura' && !d.anulada) { %>
                <form method="post" action="/almacen/documentos/<%= d.id %>/anular" style="display:inline"
                      onsubmit="return confirm('¿Anular esta factura? El inventario se devuelve.')">
                  <button class="btn peligro mini" type="submit">Anular</button>
                </form>
              <% } %>
              <% if (d.ediciones > 0) { %><small class="ayuda" style="margin:0">editada <%= d.ediciones %> vez(ces)</small><% } %>
            </td>
          </tr>
        <% }) %>
        <% if (documentos.length === 0) { %>
          <tr><td colspan="6" class="vacio">
            <% if (pago === 'todos') { %>
              No hay <%= tipo === 'factura' ? 'facturas' : 'cotizaciones' %> este día.
            <% } else { %>
              Ninguna factura de este día coincide con el filtro «<%= filtroNombre %>».
            <% } %>
          </td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</main>
</body>
</html>
