<%- include('../partials/head', { titulo: 'Bodega — ' + bodega.nombre }) %>
<%- include('../partials/barra', { usuario, activo: 'bodega' }) %>
<main>
  <% if (mensaje) { %><div class="mensaje ok"><%= mensaje %></div><% } %>
  <% if (error) { %><div class="mensaje error"><%= error %></div><% } %>

  <div class="panel">
    <div class="fila-filtro">
      <div>
        <h2 style="margin-bottom:2px"><%= bodega.nombre %></h2>
        <p class="ayuda" style="margin:0">
          La bodega de <%= almacen.nombre %>. Aquí no se vende: la mercancía entra, se guarda y se
          despacha a los almacenes con una hoja de traslado.
        </p>
      </div>
      <a class="btn cobrar" style="margin-left:auto" href="/almacen/bodega/traslados">Despachar mercancía</a>
    </div>
  </div>

  <div class="panel">
    <h3>Agregar o actualizar un producto</h3>
    <form method="post" action="/almacen/bodega/productos">
      <div class="rejilla tres">
        <label class="campo ancho" style="grid-column:1/2">Nombre del producto <input type="text" name="nombre" id="bNombre" required></label>
        <label class="campo">Unidad <input type="text" name="unidad" id="bUnidad" value="unidad" placeholder="unidad, metro, kg"></label>
        <label class="campo">Existencias iniciales <input type="number" name="existencias" min="0" step="0.01" value="0"></label>
        <label class="check" style="align-self:end"><input type="checkbox" name="controla_stock" checked> Descontar al despachar</label>
      </div>
      <div style="margin-top:14px"><button class="btn prim" type="submit">Guardar producto</button></div>
    </form>
  </div>

  <div class="panel">
    <h3>Cargar el inventario desde Excel</h3>
    <p class="ayuda">
      Descarga el archivo con lo que hay hoy en la bodega, llénalo en Excel y súbelo. Lo que no exista
      se crea y lo que ya esté se actualiza.
    </p>
    <form method="post" action="/almacen/bodega/importar" enctype="multipart/form-data">
      <div class="rejilla tres">
        <label class="campo">Archivo lleno (.xlsx, .xls o .csv)
          <input type="file" name="archivo" accept=".xlsx,.xls,.csv" required>
        </label>
        <label class="campo">Las existencias del archivo
          <select name="modo_existencias">
            <option value="reemplazar">Reemplazan las actuales</option>
            <option value="sumar">Se suman a las actuales</option>
          </select>
        </label>
        <div class="campo" style="justify-content:flex-end">
          <a class="btn linea" href="/almacen/bodega/excel">Descargar el inventario en Excel</a>
        </div>
      </div>
      <div style="margin-top:14px"><button class="btn prim" type="submit">Revisar archivo</button></div>
    </form>
  </div>

  <div class="panel">
    <h3>Inventario de la bodega (<%= productos.filter(p => p.activo).length %> productos)</h3>
    <table class="tabla">
      <thead>
        <tr><th>Producto</th><th>Unidad</th><th class="n">Existencias</th><th class="n">Entrada</th><th></th></tr>
      </thead>
      <tbody>
        <% productos.filter(p => p.activo).forEach(p => { %>
          <tr<%= Number(p.existencias) <= 0 && p.controla_stock ? ' class="sin-stock"' : '' %>>
            <td><%= p.nombre %></td>
            <td><%= p.unidad %></td>
            <td class="n"><%= p.controla_stock ? fmtCant(p.existencias) : '—' %></td>
            <td class="n">
              <form method="post" action="/almacen/bodega/productos/<%= p.id %>/entrada" style="display:flex;gap:6px;justify-content:flex-end">
                <input class="in n" style="width:90px" type="number" name="cantidad" step="0.01" placeholder="+ cant.">
                <button class="btn linea mini" type="submit">Entró</button>
              </form>
            </td>
            <td class="n">
              <button type="button" class="btn linea mini"
                onclick="editar('<%= p.nombre.replace(/'/g, "\\'") %>','<%= p.unidad.replace(/'/g, "\\'") %>')">Editar</button>
              <form method="post" action="/almacen/bodega/productos/<%= p.id %>/eliminar" style="display:inline"
                    onsubmit="return confirm('¿Quitar este producto de la bodega?')">
                <button class="btn peligro mini" type="submit">Quitar</button>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (productos.filter(p => p.activo).length === 0) { %>
          <tr><td colspan="5" class="vacio">La bodega todavía no tiene productos.</td></tr>
        <% } %>
      </tbody>
    </table>
    <p class="ayuda" style="margin-top:14px">
      Cuánto vale esta mercancía lo ve la administración en su panel, con el precio de costo; por eso
      no aparece en esta pantalla.
    </p>
  </div>
</main>
<script>
function editar(nombre, unidad){
  document.getElementById('bNombre').value = nombre;
  document.getElementById('bUnidad').value = unidad;
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
</script>
</body>
</html>
